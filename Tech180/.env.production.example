# Configure these values in the hosting provider's encrypted environment.
# Do not rename this file to .env on a production server or commit real values.
TECH180_ENV=production
TECH180_ALLOWED_ORIGINS=https://jisystems.net,https://app.jisystems.net

# Production browser requests must use authenticated server sessions. A static
# REACT_APP_* token is visible to every visitor and is not a production secret.
# The publishable key is intentionally non-secret. It lets the backend ask
# Supabase to validate the signed-in user's own session and RLS permissions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Reserve privileged keys for future Stripe webhook/account administration.
# They must exist only in Google Secret Manager, never React or Git.
SUPABASE_SECRET_KEY=sb_secret_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# OPENAI_API_KEY=
